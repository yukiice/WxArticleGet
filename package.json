{
  "name": "wx-article-hub",
  "version": "0.1.0",
  "private": true,
  "description": "微信公众号文章聚合、AI 总结与邮件推送",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "dev": "turbo run dev",
    "db:generate": "pnpm --filter @wx/db generate",
    "db:migrate": "pnpm --filter @wx/db migrate",
    "db:studio": "pnpm --filter @wx/db studio",
    "poc:article": "pnpm --filter @wx/wechat poc"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
