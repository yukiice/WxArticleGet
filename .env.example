# ---- 运行环境 ----
# NODE_ENV 不要写在这里：next start / Docker 生产镜像需要 production，
# 本地 pnpm dev 由框架自行设为 development。Cookie 的 Secure 属性改由 APP_BASE_URL 是否为 https 决定。
PORT=3001
APP_BASE_URL=http://localhost:3000
# 相对路径以仓库根目录为基准，API 与 worker 共用；容器内覆盖为 /data
DATA_DIR=./data
TZ=Asia/Shanghai

# ---- 数据库（MySQL 8.0+，数据库必须运行在 UTC 时区）----
DATABASE_URL=mysql://wx:wx@localhost:3306/wx_article
MYSQL_USER=wx
MYSQL_PASSWORD=wx
MYSQL_DATABASE=wx_article
MYSQL_ROOT_PASSWORD=wx-root

# ---- 登录（单用户）----
AUTH_SECRET=please-change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me

# ---- AI 总结（DeepSeek）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 邮件（163 个人邮箱）----
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@163.com
SMTP_PASS=
MAIL_FROM=you@163.com
MAIL_TO=you@163.com

# ---- 调度时间 ----
CATALOG_CRON=0 3 * * *
FETCH_CRON=30 8 * * *
SUMMARY_CRON=45 8 * * *
FIRST_RUN_LOOKBACK_DAYS=3

# ---- 数据源（可选，自建服务地址）----
WECHAT_SEARCH_ENDPOINT=
RSSHUB_BASE_URL=

# ---- 前端访问后端 ----
API_INTERNAL_URL=http://localhost:3001
