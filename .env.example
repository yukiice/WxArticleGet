# ---- 运行环境 ----
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3000
DATA_DIR=./data
TZ=Asia/Shanghai

# ---- 数据库 ----
DATABASE_URL=postgresql://wx:wx@localhost:5432/wx_article?schema=public

# ---- 登录（单用户）----
AUTH_SECRET=please-change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me

# ---- AI 总结（DeepSeek）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 邮件（163 个人邮箱）----
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@163.com
SMTP_PASS=
MAIL_FROM=you@163.com
MAIL_TO=you@163.com

# ---- 调度时间 ----
CATALOG_CRON=0 3 * * *
FETCH_CRON=0 7 * * *
SUMMARY_CRON=30 7 * * *
DIGEST_CRON=0 8 * * *
FIRST_RUN_LOOKBACK_DAYS=3

# ---- 数据源（可选，自建服务地址）----
WECHAT_SEARCH_ENDPOINT=
RSSHUB_BASE_URL=

# ---- 前端访问后端 ----
API_INTERNAL_URL=http://localhost:3001
