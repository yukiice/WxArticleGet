# ---- 运行环境 ----
# NODE_ENV 不要写在这里：next start / Docker 生产镜像需要 production，
# 本地 pnpm dev 由框架自行设为 development。Cookie 的 Secure 属性改由 APP_BASE_URL 是否为 https 决定。
PORT=3000
APP_BASE_URL=http://localhost:3000
# 相对路径以仓库根目录为基准，应用使用；容器内覆盖为 /data
DATA_DIR=./data
TZ=Asia/Shanghai

# ---- 数据库（MySQL 8.0.13+，全局时区可保持 +08:00）----
# Docker 部署：填写容器可访问的地址，不能填 localhost。密码特殊字符需 URL 编码。
# 已有数据库容器将端口映射到宿主机时可用 host.docker.internal。
DATABASE_URL=mysql://wx:你的数据库密码@host.docker.internal:3306/wx_article
# ---- 登录（单用户）----
AUTH_SECRET=please-change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me

# ---- AI 总结（DeepSeek）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 邮件（163 个人邮箱）----
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@163.com
SMTP_PASS=
MAIL_FROM=you@163.com
MAIL_TO=you@163.com

# ---- 调度时间 ----
CATALOG_CRON=0 3 * * *
FETCH_CRON=30 8 * * *
SUMMARY_CRON=45 8 * * *
FIRST_RUN_LOOKBACK_DAYS=3

# ---- 数据源（可选，自建服务地址）----
WECHAT_SEARCH_ENDPOINT=
RSSHUB_BASE_URL=

# ---- 构建源（国内默认值，可按需覆盖）----
# Docker Hub 拉取慢时，可填你自己的镜像仓库中对应的 Node 24 bookworm 完整版镜像。
NODE_IMAGE=node:24-bookworm
NPM_REGISTRY=https://registry.npmmirror.com
PRISMA_ENGINES_MIRROR=https://cdn.npmmirror.com/binaries/prisma
